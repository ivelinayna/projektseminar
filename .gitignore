#Firmendaten, nie committen
data/raw/*
data/processed/*
data/manual/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

#Externe öffentliche Daten (z. B. DWD-Wetter), groß
external/

#Ergebnisse, teils mit vertraulichen Bildern
outputs/*
!outputs/.gitkeep

#Modellpakete, aus Firmendaten gelernt, enthalten Zählernummern
models/*
!models/README.md

#Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

#Jupyter
notebooks/.ipynb_checkpoints/
notebooks/artifacts/
notebooks/models/
notebooks/outputs/
notebooks/*_EXECUTED.ipynb

#Dashboard-HTML aus Notebook 31, 33 und 37 enthält Adressen, nie hochladen
notebooks/fernwaerme_dashboard*.html

#Arbeitsdateien der Netz-Notebooks 31 bis 33 (Adressen, Koordinaten, Cache)
notebooks/*.csv
notebooks/*.ods
notebooks/*.png
notebooks/*.html
notebooks/daten_cache/
notebooks/*.geojson

#IDE
.vscode/
.idea/
*.swp
.DS_Store

#Umgebung
.env
.env.local

#MkDocs und Read the Docs
site/
_build/

#Review-Snapshots, können vertrauliche Daten enthalten
*-review.zip

#Lokale Ablage und alter Stand, werden nie committet
to_ignore/
archiv/
